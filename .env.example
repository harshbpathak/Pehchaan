# Environment variables are read directly; no implicit .env loading.
# Gemma tool calling through Google AI Studio.
# auto (default): chain every provider with a key (AI Studio free tier first, then
# OpenRouter), offline specialists when none has a key or all fail (disclosed).
PEHCHAN_INFERENCE=auto
# PEHCHAN_LLM_MODEL is still read as a legacy alias for PEHCHAN_GEMINI_MODEL.
# Set securely in the backend process environment; never commit a key.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alternative
# OPENROUTER_API_KEY=
# PEHCHAN_GEMINI_MODEL=gemma-4-31b-it
# PEHCHAN_OPENROUTER_MODEL=google/gemma-4-31b-it
# PEHCHAN_HOSTED_FALLBACK=1
# PEHCHAN_INFERENCE=deterministic  # explicit offline baseline
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=16379
FALKORDB_GRAPH=pehchan
# FALKORDB_PASSWORD=
# FALKORDB_USERNAME=
# FALKORDB_SSL=true
# PEHCHAN_MODEL_DIR=C:/Pehchaan/.models
# PEHCHAN_TORCH_THREADS=4
# PEHCHAN_API_URL=http://127.0.0.1:8000
# Configure distinct tokens before non-local/public access.
# PEHCHAN_API_TOKEN=
# PEHCHAN_WRITE_TOKEN=
# PEHCHAN_UI_TOKEN=
# PEHCHAN_PUBLIC_HOSTS=your-https-host.example
